{
  "name": "state-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Симулятор государства: стратегия развития городов и агломерации",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "build:single": "tsc --noEmit && node scripts/build-single.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
